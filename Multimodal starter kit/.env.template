######################### API KEYS #########################
# Google API key for accessing Google services
# Needed for Embodied Reasoning VLM
GOOGLE_API_KEY=***

# Azure API key and endpoint for accessing Azure services
AZURE_OPENAI_API_KEY=***
# Note: The endpoint should be in the format "https://<your-resource-name>.openai.azure.com/openai/v1"
AZURE_OPENAI_ENDPOINT=***

############################################################

# SQLite database files
AGENT_DATABASE_FILE=runtime_data/fair_agent.db
SERVER_DATABASE_FILE=runtime_data/fair_server.db

# Service ports
AGENT_PORT=3000
CAMERA_MCP_PORT=5000
ROBOT_MCP_PORT=5001
VLM_MCP_PORT=5002
KNOWLEDGE_MCP_PORT=5003
TGUI_PORT=3001
REDIS_PORT=6379

# MCP service URLs
MCP_SERVER_CAMERA_URL=http://host.docker.internal:5000/mcp
MCP_SERVER_ROBOT_URL=http://host.docker.internal:5001/mcp
MCP_SERVER_VLM_URL=http://vlm-mcp-service:5002/mcp
MCP_SERVER_KNOWLEDGE_URL=http://knowledge-mcp-service:5003/mcp

# VLM configuration
VLM_MODEL_ID=gemini-robotics-er-1.6-preview

# Knowledge configuration
KNOWLEDGE_EMBEDDING_PROVIDER=azure_foundry
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-large
KNOWLEDGE_VECTOR_DB_URI=runtime_data/knowledge.lancedb
KNOWLEDGE_TABLE_NAME=knowledge_pieces
KNOWLEDGE_EVENT_SOURCE=knowledge-mcp-service
KNOWLEDGE_RETRIEVE_TOOL_NAME=retrieve_relevant_knowledge
KNOWLEDGE_TEXT_SEARCH_TOOL_NAME=search_knowledge_text

# Backend event stream configuration
REDIS_URL=redis://redis:6379
BACKEND_EVENT_STREAM=stream:backend-events
REDIS_STREAM_MAXLEN=1000

# TGUI/debug frontend configuration
GUI_ENABLED=true
GUI_EVENT_BUFFER_SIZE=200
GUI_TOOL_DETAILS_ENABLED=true
GUI_TOOL_DETAIL_BUFFER_SIZE=200
TGUI_REPLAY_COUNT=200